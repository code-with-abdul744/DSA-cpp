#include <iostream>
using namespace std;

void variable()
{
    // Variables
    // A variable is a named memory location used to store data in a program. its value can change during program execution.

    // example: store number in variable
    int num = 20;
    cout << "number is: " << num << endl;


    // example: store name age in a variable
    string name = "Abdul shayan";
    int age = 20;

    cout << name << endl;
    cout << age << endl;

}

// Main function
int main()
{
    variable();
}